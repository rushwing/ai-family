{
  "schema_version": 1,
  "active_stage": "R1",
  "documentation_req": "REQ-012",
  "stages": [
    {
      "id": "R1",
      "title": "Home Integration Foundation",
      "status": "active",
      "horizon": "NOW",
      "goal": "Connect HA, normalize current state and safely execute vendor-neutral device actions.",
      "capabilities": "HA REST/WebSocket; canonical models/capabilities; mapper; state; guard/audit; mocks; API.",
      "exit_criteria": "Demonstrate an authorized confirmed action on one existing physical device through the canonical API with reported completion, audit and failure recovery. Mock CI passes without HA.",
      "dependencies": "Existing identity/audit/task boundaries; HI-F001–HI-F010.",
      "depends_on": []
    },
    {
      "id": "R2",
      "title": "Household Workflow MVP",
      "status": "planned",
      "horizon": "NEXT",
      "goal": "Deliver reviewed household workflows rather than isolated device commands.",
      "capabilities": "Runtime/persistence; trigger/condition/wait/timeout/retry; confirmation; sleep, aquarium, laundry and mock cleaning; notifications.",
      "exit_criteria": "Restart a run without duplicated physical effects; demonstrate all four scenarios with defined failure paths and duplicate-feeding prevention.",
      "dependencies": "R1; HI-F101–HI-F110.",
      "depends_on": [
        "R1"
      ]
    },
    {
      "id": "R3",
      "title": "Family Context Engine",
      "status": "planned",
      "horizon": "NEXT",
      "goal": "Interpret who is present, where, when and what is happening.",
      "capabilities": "Person/presence; occupancy; home/away/sleeping modes; activity; temporal context.",
      "exit_criteria": "Explain provenance and freshness of scoped context; unknown presence does not become a safety-sensitive assumption.",
      "dependencies": "R1 state; R2 runtime; privacy and member authorization.",
      "depends_on": [
        "R1",
        "R2"
      ]
    },
    {
      "id": "R4",
      "title": "Event Intelligence",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Derive meaningful household events from correlated device observations.",
      "capabilities": "Temporal windows; correlation; derived events; deduplication; event history.",
      "exit_criteria": "A repeatable fixture combines observations into an explainable household event without duplicate triggers.",
      "dependencies": "R2 triggers; R3 context.",
      "depends_on": [
        "R2",
        "R3"
      ]
    },
    {
      "id": "R5",
      "title": "Household Memory",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Answer authorized questions about household facts, preferences, routines and history.",
      "capabilities": "Separate facts/preferences/routines/events/device and workflow history; structured storage before vectors.",
      "exit_criteria": "Answer feeding-history and infrastructure-history questions with source evidence; enforce access, retention and deletion policy.",
      "dependencies": "R3 context; R4 events; existing privacy/data architecture.",
      "depends_on": [
        "R3",
        "R4"
      ]
    },
    {
      "id": "R6",
      "title": "Policy & Autonomous Action",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Expand autonomous action only within explicit governed boundaries.",
      "capabilities": "Risk tiers; permission; confirmation; audit; compensation/rollback where physically possible.",
      "exit_criteria": "Low-risk autonomy obeys policy; high-risk actions require human confirmation; irreversible/uncertain outcomes are explicit.",
      "dependencies": "R1 guard from day one; R2 workflow; R3 context; R5 memory.",
      "depends_on": [
        "R1",
        "R2",
        "R3",
        "R5"
      ]
    },
    {
      "id": "R7",
      "title": "AI Planner / Household Agent",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Turn ambiguous household intent into a reviewed structured executable plan.",
      "capabilities": "Intent interpretation; multistep plans; context reasoning; recommendations; exception suggestions.",
      "exit_criteria": "A structured plan passes policy validation before execution; no LLM call can dispatch to a device provider directly.",
      "dependencies": "R2 workflow; R3 context; R5 memory; R6 policy; platform planner work.",
      "depends_on": [
        "R2",
        "R3",
        "R5",
        "R6"
      ]
    },
    {
      "id": "R8",
      "title": "Spatial Intelligence",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Model floors, rooms, areas, zones and static/movable locations without a vendor dependency.",
      "capabilities": "Canonical maps; robot rooms; optional BLE/UWB/camera/Matter occupancy integrations.",
      "exit_criteria": "Replace a robot/map adapter without changing canonical spatial IDs or workflow references.",
      "dependencies": "R1 canonical identities; R3 context.",
      "depends_on": [
        "R1",
        "R3"
      ]
    },
    {
      "id": "R9",
      "title": "Multimodal Home Understanding",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Interpret visual household observations within a local-first privacy boundary.",
      "capabilities": "Camera/RTSP/ONVIF; image events; VLM; door/package/pet/floor observations.",
      "exit_criteria": "Consent, local processing, scoped access and retention are verified; uncertain recognition cannot directly trigger unsafe action.",
      "dependencies": "R4 events; R6 policy; R8 spatial model.",
      "depends_on": [
        "R4",
        "R6",
        "R8"
      ]
    },
    {
      "id": "R10",
      "title": "Natural Interaction",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Expose one governed backend through multiple household interaction channels.",
      "capabilities": "Web/mobile; Telegram; voice; Siri/Shortcuts; notifications.",
      "exit_criteria": "Equivalent authorized intent from two channels produces the same reviewed action semantics; channels cannot bypass policy.",
      "dependencies": "R1 API; R2 notifications; R7 plans. Existing web prototype is a starting asset.",
      "depends_on": [
        "R1",
        "R2",
        "R7"
      ]
    },
    {
      "id": "R11",
      "title": "Reliability & Home Operations",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Operate the household service with recoverable failures on NAS/Pi/home servers.",
      "capabilities": "Health/watchdog; metrics/traces/alerts; dead letters; validation; backup; disaster recovery.",
      "exit_criteria": "An outage and restore drill meets documented recovery targets and produces runtime evidence; local manual control remains available.",
      "dependencies": "Each stage must already satisfy baseline reliability; platform REQ-010 and operational ADRs.",
      "depends_on": [
        "R1"
      ]
    },
    {
      "id": "R12",
      "title": "Open Home Intelligence Platform",
      "status": "planned",
      "horizon": "LATER",
      "goal": "Extend adapters, capabilities and workflows without changing the core.",
      "capabilities": "Plugin/Adapter/Capability/Workflow SDKs; APIs/webhooks; MCP integration; developer documentation.",
      "exit_criteria": "A reference third-party adapter passes contracts and policy registration without core modifications.",
      "dependencies": "R1 contracts; R2 workflow; R6 policy; R11 operations.",
      "depends_on": [
        "R1",
        "R2",
        "R6",
        "R11"
      ]
    }
  ],
